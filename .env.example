# Dev-only: a Hardcover personal access token, used instead of OAuth when set.
HARDCOVER_TOKEN=
# Optional: override the compiled-in OAuth client_id.
HARDCOVER_CLIENT_ID=
# Optional: force the interface scale on top of the desktop's (1 turns the
# automatic scale for large monitors off). HARDCOVER_UI_SCALE_DEBUG=1 logs it.
HARDCOVER_UI_SCALE=
